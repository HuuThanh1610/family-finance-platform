# PostgreSQL superuser (bootstrap only)
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=changeme_postgres_super
POSTGRES_PORT=5432

# Per-service DB credentials (must match infra/postgres/init)
PROFILE_DB_USER=profile_user
PROFILE_DB_PASSWORD=changeme_profile
FAMILY_DB_USER=family_user
FAMILY_DB_PASSWORD=changeme_family
WALLET_DB_USER=wallet_user
WALLET_DB_PASSWORD=changeme_wallet
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=changeme_payment
BUDGET_DB_USER=budget_user
BUDGET_DB_PASSWORD=changeme_budget
EXPENSE_DB_USER=expense_user
EXPENSE_DB_PASSWORD=changeme_expense
HOUSEHOLD_DB_USER=household_user
HOUSEHOLD_DB_PASSWORD=changeme_household
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=changeme_notification
ANALYTICS_DB_USER=analytics_user
ANALYTICS_DB_PASSWORD=changeme_analytics

# Frontend
VITE_API_BASE_URL=http://localhost:8080
VITE_USE_MOCK=false
WEB_PORT=5173

# Optional infra (docker compose --profile full)
REDIS_PORT=6379
KAFKA_PORT=9092
KEYCLOAK_PORT=8180
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme_keycloak_admin
# Browser/JWT issuer (must match token `iss` claim)
KEYCLOAK_ISSUER_URI=http://localhost:8180/realms/family-finance
# In Docker Compose full profile, set to Keycloak internal JWKS URL (see infra/compose/apps.yml)
KEYCLOAK_JWK_SET_URI=
INTERNAL_API_KEY=dev-internal-change-me
FAMILY_AUTH_ENABLED=true
# Compose profile `full` defaults SECURITY_ENABLED/KAFKA_ENABLED to true; local IDE runs still default false via application.yml
SECURITY_ENABLED=false
# Runtime E2E (PaymentProviderPaid → wallet credit): docker compose --profile full + KAFKA_ENABLED=true
KAFKA_ENABLED=false
PAYMENT_PROVIDER=fake

# Observability (docker compose --profile observability)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_grafana_admin
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_HEALTH_PORT=13133
TEMPO_PORT=3200
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLING_PROBABILITY=1.0

# Payment service (port 8084)
PAYMENT_DB_USER=payment_user
PAYMENT_DB_PASSWORD=changeme_payment

# MoMo sandbox (test-payment.momo.vn) — NEVER commit real secrets
MOMO_ENVIRONMENT=sandbox
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_BASE_URL=https://test-payment.momo.vn
MOMO_REDIRECT_URL=http://localhost:5173/payments/return
# Public HTTPS URL MoMo can POST IPN to, e.g. ngrok/cloudflared tunnel:
#   ngrok http 8084
#   MOMO_IPN_URL=https://<tunnel-host>/api/v1/payments/momo/ipn
MOMO_IPN_URL=
